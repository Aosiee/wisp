// wisp_text: Wisp's engine-free text models - the Markdown parser
// (Wisp/Doc/) and the Luau tokenizer (Wisp/Code/) - in their own plugin so a
// tool with no engine (tinydoc's site renderer) links exactly what the
// editor's DocView and CodeEditor paint from. Includes stay "Wisp/Doc/..." /
// "Wisp/Code/..." (the include root is src/, like Wisp's).

plugin "wisp_text" {
    enabled_by_default = false,
}

let sanitizers = require "build/sanitizers"

module "wisp_text" {
    sources = glob("src/**/*.cpp"),
    public_includes = { "src" },
    flags = sanitizers.flags,
    public_link_flags = sanitizers.link_flags,
    cpp_std = "c++20",
}
