# The house faces built into wisp::fonts: each TTF in fonts/ttf/ as a byte
# array in fonts/src/Wisp/Fonts/Embedded/<name>.inc. MODE=update rewrites
# the arrays, MODE=check fails when one differs from its TTF.
#
#     cmake -DMODE=update -P fonts/Embed.cmake
file(GLOB faces "${CMAKE_CURRENT_LIST_DIR}/ttf/*.ttf")
set(stale "")
foreach(face ${faces})
    get_filename_component(name ${face} NAME_WE)
    file(READ ${face} hex HEX)
    string(LENGTH "${hex}" length)
    # 16 bytes a line (CMake's regex has no {n}: the line's 32 digits are
    # spelled out).
    string(REPEAT "[0-9a-f]" 32 line)
    string(REGEX REPLACE "(${line})" "\\1\n" lines "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${lines}")
    math(EXPR size "${length} / 2")
    set(text "// ${name}.ttf, ${size} bytes: generated by fonts/Embed.cmake from fonts/ttf/ (MODE=update).\n${bytes}\n")
    set(out "${CMAKE_CURRENT_LIST_DIR}/src/Wisp/Fonts/Embedded/${name}.inc")
    if(MODE STREQUAL "update")
        file(WRITE ${out} "${text}")
    else()
        set(committed "")
        if(EXISTS ${out})
            file(READ ${out} committed)
        endif()
        if(NOT committed STREQUAL text)
            list(APPEND stale ${name})
        endif()
    endif()
endforeach()
if(stale)
    message(FATAL_ERROR "The built-in faces are stale (${stale}): run cmake -DMODE=update -P fonts/Embed.cmake and commit the arrays.")
endif()
